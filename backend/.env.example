# Groq Cloud API Key (Get your key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier
GROQ_MODEL=openai/gpt-oss-20b

# Maximum Upload Size in Bytes (10 MB = 10485760)
MAX_FILE_SIZE=10485760

# Groq API Request Timeout in Seconds
REQUEST_TIMEOUT=60.0

# Faster-Whisper Model Size (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=small

# Allowed CORS Origins (comma-separated, defaults to local dev frontends)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
